# Salin jadi .env lalu isi. File .env TIDAK boleh di-commit.

# === Wajib ===
DATABASE_URL="postgresql://postgres:PASSWORD_POSTGRES@localhost:5432/shareen"
JWT_SECRET=""                 # string acak panjang, contoh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
FRONTEND_URL="http://localhost:5173"
PORT=3000

# === Google OAuth (opsional — kosong = tombol login Google nonaktif) ===
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# === Directus (Phase 2) ===
DIRECTUS_URL=""
DIRECTUS_TOKEN=""

# === RajaOngkir (Phase 3) ===
RAJAONGKIR_API_KEY=""
RAJAONGKIR_ORIGIN_ID="4870"  # Caringin, Bandung Kulon, Kota Bandung — lokasi gudang Shareen

# === Midtrans Sandbox (Phase 3) ===
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
